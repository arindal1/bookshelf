# Copy to .env.local and fill in real values. Never commit real secrets.

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Demo credentials provider (mock-data-first phase only - see docs/DECISIONS.md
# ADR-006). Password required to sign in as the mock reader account until a
# real Prisma-backed user store replaces it.
DEMO_USER_PASSWORD="readmore-demo"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth - GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""